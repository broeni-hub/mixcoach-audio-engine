# Vorlage. Kopieren nach Frontend/.env und die echten Werte eintragen:
#   cp .env.example .env
#
# .env selbst gehoert NICHT ins Repo (steht in .gitignore). Die Werte findest
# du im Supabase-Projekt unter Project Settings -> API, bzw. im
# Lovable-Projekt unter Cloud.

# Projekt-URL, Form: https://<projekt-ref>.supabase.co
SUPABASE_URL=

# Service-Role-Key. Umgeht Row Level Security und darf ausschliesslich
# serverseitig verwendet werden (Frontend/src/integrations/supabase/
# client.server.ts) - niemals in Client-Bundles, niemals ins Repo.
SUPABASE_SERVICE_ROLE_KEY=
